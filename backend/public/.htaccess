<IfModule mod_rewrite.c>
    RewriteEngine On

    Options -Indexes

    <FilesMatch "^(\.env|\.env\..*|composer\.(json|lock)|README\.md|.*\.(sql|sqlite|db|log|bak|zip|tar|gz))$">
        Require all denied
    </FilesMatch>

    <FilesMatch "\.(phtml|php3|php4|php5|php7|php8|phar)$">
        Require all denied
    </FilesMatch>

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [L]
</IfModule>
